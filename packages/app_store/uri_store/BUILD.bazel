load("@rules_flutter_core//flutter:defs.bzl", "flutter_package", "flutter_pubspec", "flutter_test_suite")

package(default_visibility = ["//visibility:public"])

exports_files(["pubspec.lock"])

flutter_pubspec()

filegroup(
    name = "srcs",
    srcs = glob(["lib/**/*.dart"]),
)

flutter_package(
    name = "package",
    path_deps = ["//packages/app_store/shared:srcs"],
    pub = "@pub_uri_store",
    pubspec = ":pubspec",
)

flutter_test_suite(
    name = "tests",
    package = ":package",
)
